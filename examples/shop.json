{
  "version": 1,
  "seed": 42,
  "output": { "format": "csv", "dir": "output/shop" },
  "types": {
    "money": {
      "type": "object",
      "fields": {
        "amount": { "type": "float", "min": 5, "max": 500, "precision": 2 },
        "currency": { "type": "constant", "value": "EUR" }
      }
    }
  },
  "entities": {
    "customer": {
      "count": 1000,
      "fields": {
        "id": { "type": "sequence", "start": 1001 },
        "external_ref": { "type": "uuid" },
        "first_name": {
          "type": "choice",
          "values": ["Asha", "Ravi", "Meera", "José", "Erin", "Tom"],
          "hidden": true
        },
        "last_name": {
          "type": "choice",
          "values": ["Rao", "Nair", "O'Brien", "Smith", "Müller"],
          "hidden": true
        },
        "email": {
          "type": "template",
          "template": "{first_name|slug}.{last_name|slug}@example.com"
        },
        "tier": { "type": "choice", "values": ["free || 70", "pro || 25", "enterprise || 5"] },
        "age": {
          "type": "integer",
          "ranges": ["18 to 35 || 0.7", "36 to 60 || 0.25", "61 to 90 || 0.05"]
        },
        "country": { "type": "choice", "values": ["IN", "US", "GB", "DE"] },
        "marketing_opt_in": { "type": "boolean", "true_probability": 0.3 },
        "signup_date": { "type": "date", "min": "2022-01-01", "max": "2025-12-31" },
        "referral_code": {
          "type": "choice",
          "values": ["FRIEND10 || 0.2", "LAUNCH25 || 0.2", "PARTNER || 0.1", " || 0.5"]
        },
        "address": {
          "type": "object",
          "null_probability": 0.1,
          "fields": {
            "city": { "type": "choice", "values": ["Pune", "Austin", "Leeds", "Kochi", "Denver"] },
            "postcode": { "type": "integer", "min": 10000, "max": 99999 }
          }
        }
      }
    },
    "product": {
      "count": 50,
      "fields": {
        "id": { "type": "sequence" },
        "code": { "type": "pattern", "pattern": "SKU-??-####", "unique": true },
        "list_price": {
          "type": "money",
          "fields": { "currency": { "type": "constant", "value": "USD" } }
        },
        "category": { "type": "choice", "values": ["books", "games", "music", "tools"] },
        "price": {
          "type": "float",
          "distribution": "normal",
          "mean": 40,
          "stddev": 15,
          "min": 5,
          "max": 200,
          "precision": 2
        },
        "currency": { "type": "constant", "value": "EUR" },
        "in_stock": { "type": "boolean", "true_probability": 0.9 }
      }
    },
    "order": {
      "count": 5000,
      "fields": {
        "id": { "type": "uuid" },
        "customer_id": "$customer.id",
        "customer_tier": "$customer.tier",
        "ship_city": "$customer.address.city",
        "status": {
          "type": "choice",
          "values": ["delivered || 0.75", "shipped || 0.12", "pending || 0.08", "cancelled || 0.05"]
        },
        "placed_at": {
          "type": "datetime",
          "min": "2025-01-01T00:00:00",
          "max": "2025-12-31T23:59:59"
        },
        "discount_pct": { "type": "integer", "min": 5, "max": 30, "null_probability": 0.6 }
      }
    },
    "order_item": {
      "count": 12000,
      "fields": {
        "id": { "type": "sequence" },
        "order_id": "$order.id",
        "product_id": "$product.id",
        "unit_price": "$product.price",
        "quantity": {
          "type": "integer",
          "ranges": ["1 to 1 || 60", "2 to 3 || 30", "4 to 10 || 10"]
        },
        "gift_wrap_level": {
          "type": "choice",
          "value_type": "integer",
          "values": ["0 || 80", "1 || 15", "2 || 5"]
        }
      }
    }
  }
}
